{
  "name": "greenility-ui",
  "version": "0.1.0",
  "description": "An accessible, themeable React component library: strict TypeScript, design tokens with light and dark themes, WAI-ARIA patterns, and automated accessibility tests.",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "accessibility",
    "a11y",
    "wai-aria",
    "typescript",
    "design-tokens",
    "storybook"
  ],
  "homepage": "https://greenility-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrandonGreenDev/greenility-ui.git"
  },
  "bugs": {
    "url": "https://github.com/BrandonGreenDev/greenility-ui/issues"
  },
  "author": "Brandon Green",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/run.ts storybook dev -p 6006",
    "storybook": "node scripts/run.ts storybook dev -p 6006",
    "build-storybook": "node scripts/run.ts storybook build -o storybook-static",
    "build": "node scripts/run.ts vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run.ts vitest run",
    "test:watch": "node scripts/run.ts vitest",
    "test:coverage": "node scripts/run.ts vitest run --coverage",
    "tokens": "node scripts/build-tokens.ts",
    "tokens:check": "node scripts/build-tokens.ts --check",
    "ci": "npm run tokens:check && npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run build-storybook && npm run test:a11y",
    "test:a11y": "node scripts/a11y-stories.ts"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.9",
    "@storybook/addon-docs": "^10.6.9",
    "@storybook/react-vite": "^10.6.9",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.9",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.2",
    "vitest-axe": "^0.1.0"
  }
}
